{
  "name": "learning-tree",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "import:course": "node --env-file-if-exists=.env server/import-course.ts",
    "courses:example": "node scripts/build-builtin-course.mjs",
    "courses:build": "node scripts/build-builtin-course.mjs",
    "courses:legacy-example": "node scripts/export-course.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src server scripts/*.mjs courses/*.json *.ts *.json index.html README.md docs",
    "format:check": "prettier --check src server scripts/*.mjs courses/*.json *.ts *.json index.html README.md docs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@radix-ui/colors": "3.0.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "ts-fsrs": "^5.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
